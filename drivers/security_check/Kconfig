# Kernel security and integrity check configuration
#

config KERNEL_SECURITY_CHECK
	bool "Kernel security and integrity check support"
	depends on KPROBES
	depends on CRYPTO
	depends on CRYPTO_SHA256
	depends on PROC_FS
	default y
	help
	  Say Y here to enable kernel system call table and KO integrity checks.
	  This module detects syscall table hijacking and verifies KO module
	  integrity via SHA256 hash comparison.

	  If unsure, say N.
